<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's first page: statistics and the supported games, then one entry per page of
     settings (res/xml/reader_prefs_*.xml), under the names Furoshiki's pages have on a computer. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="reader_open_stats"
        app:title="@string/reader_statistics"
        app:summary="@string/reader_statistics_summary"
        app:iconSpaceReserved="false" />
    <Preference
        app:key="reader_open_games"
        app:title="@string/reader_games"
        app:summary="@string/reader_games_summary"
        app:iconSpaceReserved="false" />

    <PreferenceCategory app:title="@string/reader_pref_category_settings" app:iconSpaceReserved="false">
        <!-- Any setting, by its name. -->
        <Preference
            app:key="reader_find_setting"
            app:title="@string/reader_find_setting"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reader_section_reading"
            app:title="@string/reader_section_reading"
            app:summary="@string/reader_section_reading_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reader_section_popup"
            app:title="@string/reader_section_popup"
            app:summary="@string/reader_section_popup_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reader_open_dictionaries"
            app:title="@string/reader_dictionaries"
            app:summary="@string/reader_section_dictionaries_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reader_section_cards"
            app:title="@string/reader_section_cards"
            app:summary="@string/reader_section_cards_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reader_section_sources"
            app:title="@string/reader_section_sources"
            app:summary="@string/reader_section_sources_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reader_section_controller"
            app:title="@string/reader_section_controller"
            app:summary="@string/reader_section_controller_summary"
            app:iconSpaceReserved="false" />
        <!-- The CRT picture: a page of its own, built from the native side's table
             (reader/ui/CrtSettings.kt). -->
        <Preference
            app:key="reader_open_crt"
            app:title="CRT picture"
            app:summary="Scan lines, phosphor and curved glass: the game as on an old television"
            app:iconSpaceReserved="false" />
        <!-- The app's own page (Console.CONSOLE_PAGE, reader_prefs_console.xml): hidden where
             it has none. -->
        <Preference
            app:key="reader_section_console"
            app:title="@string/reader_pref_category_console"
            app:summary="@string/reader_section_console_summary"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
