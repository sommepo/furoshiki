{
  "name": "Slate",
  "order": 1,
  "about": "Warm grey, dot-matrix type for labels and numbers, a mint glow on the chosen row, a red accent groove",
  "page": "#a8a397",
  "bg": "repeating-conic-gradient(rgba(0,0,0,.035) 0 25%,rgba(0,0,0,0) 0 50%) 0 0/2px 2px,radial-gradient(ellipse at 40% 28%,#cdc9be 0%,#b5b0a4 58%,#9f9a8e 100%)",

  "panel-bg": "rgba(148,144,136,.26)",
  "panel-blur": 1.5,
  "panel-shadow": "inset 0 2px 0 var(--frame-dk),inset 0 -2px 0 var(--frame-dk),5px 6px 0 rgba(70,66,60,.22),0 14px 26px rgba(70,66,60,.22)",
  "frame": "#e3dfd7",
  "frame-dk": "rgba(88,84,78,.6)",
  "card-frame": "#e3dfd7",

  "txt": "#f8f7f3",
  "txt-sh": "1px 1px 0 rgba(62,58,54,.55),2px 2px 1px rgba(62,58,54,.7),3px 3px 3px rgba(62,58,54,.25)",
  "sel-txt": "#ffffff",
  "sel-sh": "2px 2px 0 rgba(70,66,60,.55)",
  "dim": "rgba(116,112,104,.62)",
  "dim-sh": "1px 1px 0 rgba(255,255,255,.5)",


  "accent": "#e0463a",
  "accent-glow": "0 0 4px rgba(255,80,60,.55)",
  "accent-groove": "linear-gradient(90deg,rgba(70,66,60,.5) 0 1px,var(--accent) 1px 2.5px,#ffb4a6 2.5px 3.5px,var(--accent) 3.5px 5px,rgba(255,255,255,.55) 5px 6px)",
  "rail-hi": "#dcd8d0",
  "rail-lo": "#a39e92",
  "divot": "#68645d",
  "divot-sh": "inset -1px 1px 0 rgba(0,0,0,.45),1px 0 0 rgba(255,255,255,.45)",
  "line": "rgba(246,244,239,.85)",

  "tab-bg": "linear-gradient(#9a968e,#74706a)",
  "tab-txt": "#e2dfd8",
  "tab-sh": "2px 2px 0 rgba(52,49,45,.8),-1px -1px 0 rgba(255,255,255,.28)",
  "tab-shadow": "inset 0 0 0 2px var(--frame-dk),5px 6px 0 rgba(70,66,60,.25)",
  "tab-height": 54,
  "tab-on": "rgba(92,88,82,.6)",

  "thumb-frame": "#f8f7f3",
  "thumb-shadow": "2px 2px 0 var(--frame-dk)",

  "orb-glow": "0 0 3px rgba(255,255,255,.85)",
  "cursor-glow": "rgba(214,255,244,.95)",

  "clock": { "top": 10, "format": "yyyy/MM/dd H:mm:ss" },
  "layout": { "detail-pad": 30, "list-pad-left": 30, "list-pad-right": 18, "vline-left": 90, "vline-right": 246 },
  "file-text": "FILE %1  %2",
  "head-case": "as-is",

  "smooth": 0.6,
  "type": {
    "head":   { "font": "DotGothic16-Regular.ttf", "size": 38, "spacing": 0.06 },
    "clock":  { "font": "DotGothic16-Regular.ttf", "size": 32, "spacing": 0.28 },
    "file":   { "font": "DotGothic16-Regular.ttf", "size": 20, "spacing": 0.42 },
    "title":  { "font": "DotGothic16-Regular.ttf", "size": 44, "line": 58 },
    "sub":    { "font": "DotGothic16-Regular.ttf", "size": 34, "line": 46 },
    "stats":  { "font": "DotGothic16-Regular.ttf", "size": 22, "spacing": 0.42, "line": 36 },
    "number": { "font": "DotGothic16-Regular.ttf", "size": 26 },
    "row":    { "font": "DotGothic16-Regular.ttf", "size": 26 },
    "empty":  { "font": "DotGothic16-Regular.ttf", "size": 26, "spacing": 0.42 },
    "when":   { "font": "DotGothic16-Regular.ttf", "size": 21, "spacing": 0.3 },
    "tab":    { "font": "DotGothic16-Regular.ttf", "size": 20 },
    "lr":     { "font": "DotGothic16-Regular.ttf", "size": 20 }
  },

  "fuzz": {
    "default": "light",
    "light": { "shift": 0.9, "blur": 0.3, "contrast": 1 },
    "heavy": { "shift": 2, "blur": 0.7, "contrast": 1.08 },
    "grain": 0.1,
    "grain-frequency": 0.9,
    "interlace": 0.05
  }
}
