<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- The Steam Controller read over USB by Furoshiki itself (steam/). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- The game takes the controller back after a touch on the second display (GameActivity). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The in-app updater (Updater.kt): a published build installs the next release itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Games are files anywhere on the device or its card, each opened by its path by a core:
         the file picker's document trees give an emulator's C++ no path. Installed by hand. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <!-- As the device's home screen (HomeScreen.kt, Device.kt): the brightness from the System
         page once the user has allowed it, and the system's notifications pulled down from there. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- A game another app plays read by OCR of the screen (companion/ScreenCapture). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Its lookups over that game, a see-through layer the companion puts over the other app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <!-- The other apps, listed on the Apps page while Furoshiki is the home screen. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The PC game apps whose exported games start at once (companion/FrontendExports). -->
        <package android:name="app.gamenative" />
        <package android:name="app.gamenative.gold" />
        <package android:name="com.winlator.cmod" />
        <package android:name="com.winlator" />
        <package android:name="com.cmodded.winlator" />
        <package android:name="com.winnative.cmod" />
        <package android:name="com.ichi2.anki" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
    </queries>

    <application
        android:name=".FuroshikiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_furoshiki_37"
        android:label="@string/app_name"
        android:appCategory="game"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Furoshiki">

        <!-- The page: nothing of an emulator or of the reader runs in this process. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true" />

        <!-- Furoshiki as the device's home screen (HomeScreen.kt): off until switched on in
             Settings, so a phone is never asked whether this is its launcher. The first display's
             home is the page; a second display's is its own page (LowerActivity), which Android
             starts there by itself as the home app's SECONDARY_HOME. -->
        <activity-alias
            android:name=".ConsoleHome"
            android:targetActivity=".HomeActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".LowerActivity"
            android:launchMode="singleTop"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.lower"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

