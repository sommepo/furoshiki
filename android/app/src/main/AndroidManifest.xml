        <!-- icons] -->

        <!-- Everything of the reader is in the process of the game, which ends with the game:
             one core a process, as emulators were never made to share one. Their task's name
             (.play) only tells where Furoshiki is the home screen: the page then starts them in
             a task of their own, so that the Home key shows the shelf (HomeScreen.apart). -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:taskAffinity="${applicationId}.play"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Furoshiki.Game" />

        <service android:name=".AppSetupService" android:process=":game" android:exported="false" />
        <!-- Add a game's name, typed on the second display of a device with two (AddTitleActivity). -->
        <activity
            android:name=".AddTitleActivity"
            android:taskAffinity="${applicationId}.addtitle"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/Theme.Furoshiki.Game" />
        <!-- Another app's game, read on the second display while that app plays it on the main one. -->
        <activity
            android:name=".companion.CompanionActivity"
            android:process=":game"
            android:taskAffinity="${applicationId}.companion"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.Furoshiki.Game" />
        <service
            android:name=".companion.ScreenCapture"
            android:process=":game"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service android:name=".ScanService" android:process=":scan" android:exported="false" />

        <!-- The popup as its settings make it, over the shelf while they are changed on the second
             display (PopupPreviewActivity); in the settings page's process, to hear its changes. -->
        <activity
            android:name=".PopupPreviewActivity"
            android:process=":game"
            android:taskAffinity="${applicationId}.preview"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Furoshiki.Preview" />
        <activity
            android:name=".reader.ui.ReaderSettingsActivity"
            android:process=":game"
            android:taskAffinity="${applicationId}.play"
            android:exported="false"
