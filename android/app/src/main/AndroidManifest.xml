        <!-- Everything of the reader is in the process of the game, which ends with the game:
             one core a process, as emulators were never made to share one. -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Furoshiki.Game" />

