<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Games are files anywhere on the device or its card, each opened by its path by a core:
         the file picker's document trees give an emulator's C++ no path. Installed by hand. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <queries>
        <package android:name="com.ichi2.anki" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
    </queries>

    <application
        android:name=".FuroshikiApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:appCategory="game"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Furoshiki">

        <!-- The page: nothing of an emulator or of the reader runs in this process. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Everything of the reader is in the process of the game, which ends with the game:
             one core a process, as emulators were never made to share one. -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Furoshiki.Game" />

        <service android:name=".AppSetupService" android:process=":game" android:exported="false" />
        <service android:name=".ScanService" android:process=":scan" android:exported="false" />

        <activity
            android:name=".reader.ui.ReaderSettingsActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_settings" />
        <activity
            android:name=".reader.ui.ReaderStatsActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_statistics" />
        <activity
            android:name=".ScriptsActivity"
            android:process=":game"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".reader.ui.ReaderGamesActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_games" />
        <activity
            android:name=".reader.ui.CrtSettingsActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_games" />
        <activity
            android:name=".reader.ui.DictionaryManagerActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_dictionaries" />
        <activity
            android:name=".reader.ui.AnkiSetupActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_anki_setup" />
        <activity
            android:name=".reader.ui.ReaderStartActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_start_title" />
        <activity
            android:name=".reader.ui.ReaderBacklogActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Reader"
            android:label="@string/reader_backlog" />

        <provider
            android:name=".reader.ReaderFileProvider"
            android:process=":game"
            android:authorities="${applicationId}.reader.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/reader_file_paths" />
        </provider>
    </application>
</manifest>
