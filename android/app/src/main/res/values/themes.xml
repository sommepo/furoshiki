        <item name="switchPreferenceCompatStyle">@style/Furoshiki.Preference.Switch</item>
        <item name="dialogPreferenceStyle">@style/Furoshiki.Preference.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Furoshiki.Preference.EditText</item>
