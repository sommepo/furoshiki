<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="reader_kon_ground">#101a3a</color>
    <style name="Theme.Furoshiki" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.Furoshiki.Game" parent="Theme.Furoshiki" />
    <style name="Theme.Furoshiki.Preview" parent="Theme.Furoshiki">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- The reader's own pages (settings, dictionaries, cards): Kon, Furoshiki's look, cream on
         indigo with the vermilion for what is on (the maintainer, 2026-11-17: settings on the lower
         screen in the app's look, not Android's light one). -->
    <style name="Theme.Reader" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#d9472b</item>
        <item name="colorOnPrimary">#101a3a</item>
        <item name="colorPrimaryContainer">#18244d</item>
        <item name="colorOnPrimaryContainer">#ece5d3</item>
        <item name="colorSecondary">#8a93b5</item>
        <item name="colorOnSecondary">#101a3a</item>
        <item name="colorSecondaryContainer">#18244d</item>
        <item name="colorOnSecondaryContainer">#ece5d3</item>
        <item name="colorTertiary">#d9472b</item>
        <item name="android:colorBackground">#101a3a</item>
        <item name="colorSurface">#101a3a</item>
        <item name="colorOnSurface">#ece5d3</item>
        <item name="colorOnSurfaceVariant">#8a93b5</item>
        <item name="colorSurfaceVariant">#18244d</item>
        <item name="colorSurfaceContainer">#18244d</item>
        <item name="colorSurfaceContainerHigh">#18244d</item>
        <item name="colorSurfaceContainerHighest">#22305e</item>
        <item name="colorOutline">#4a5480</item>
        <item name="colorOutlineVariant">#2c3766</item>
        <item name="android:windowBackground">@color/reader_kon_ground</item>
        <item name="android:statusBarColor">@color/reader_kon_ground</item>
        <item name="android:navigationBarColor">@color/reader_kon_ground</item>
    </style>
</resources>
