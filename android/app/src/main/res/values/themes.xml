        <item name="colorSurface">#101a3a</item>
        <item name="colorOnSurface">#ece5d3</item>
        <item name="colorOnSurfaceVariant">#8a93b5</item>
        <item name="colorSurfaceVariant">#18244d</item>
        <item name="colorSurfaceContainer">#18244d</item>
